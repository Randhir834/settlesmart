# Copy to .env (or set in Vercel → Project → Settings → Environment Variables).
# All optional: the site works without any of them.

# Google Analytics 4 measurement ID. Analytics only loads when this is set.
VITE_GA_MEASUREMENT_ID=

# Override the Firebase project used for the waitlist/contact form.
# Defaults to the app's `settsmartly` project (see src/config.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Public site address used for canonical URLs, the sitemap and social previews.
# Defaults to https://settsmartly.com.
VITE_SITE_URL=

# Google Search Console HTML-tag verification code (just the content="..." value).
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (the content="..." value of the msvalidate.01 meta tag).
VITE_BING_SITE_VERIFICATION=
